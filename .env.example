# Copy this file to `.env` in the repo root and fill in your key:
#   macOS / Linux:  cp .env.example .env
#   Windows:        copy .env.example .env
#
# `.env` is listed in .gitignore. Never commit it and never paste your key
# into an issue, pull request or screenshot.

# Free Gemini key: https://aistudio.google.com/apikey
GOOGLE_API_KEY=paste-your-key-here

# Which models every step uses, as "provider:model-name" (see step 01 and step 14).
# The defaults below work with the free Gemini key above. Leave them as they are to start.
MODEL=google_genai:gemini-flash-latest
EMBEDDING_MODEL=google_genai:gemini-embedding-001

# Optional: send a trace of every run to LangSmith (free account: https://smith.langchain.com).
# Not needed for the course. Remove the leading "# " on the three lines below to turn it on.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=paste-your-langsmith-key-here
# LANGSMITH_PROJECT=langchain-step-by-step
